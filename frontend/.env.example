# API REST del backend (Spring Boot) — ajustar host/puerto según entorno
VITE_API_URL=http://localhost:8080/api/v1

# Base URL del backend para construir la URL pública de imagenes de productos
VITE_IMAGE_URL=http://localhost:8080

# Imagen de respaldo cuando un producto no tiene imagen
VITE_PLACEHOLDER_IMAGE=https://via.placeholder.com/150

# Cantidad de productos a mostrar por página en la grilla
VITE_PRODUCTS_PER_PAGE=12